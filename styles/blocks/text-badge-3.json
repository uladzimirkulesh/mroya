{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Badge 3",
	"slug": "text-badge-3",
	"blockTypes": [
		"core/heading",
		"core/paragraph"
	],
	"styles": {
		"color": {
			"text": "rgb(255, 255, 255)",
			"background": "rgba(255, 255, 255, 0.15)"
		},
		"typography": {
			"fontSize": "var:preset|font-size|xx-small",
			"fontWeight": "500",
			"lineHeight": "var:custom|typography|line-height|xx-small",
			"letterSpacing": "var:custom|typography|letter-spacing|xx-small"
		},
		"spacing": {
			"padding": {
				"top": "0.375rem",
				"right": "0.75rem",
				"bottom": "0.375rem",
				"left": "0.75rem"
			}
		},
		"border": {
			"radius": "0.1875rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "currentColor"
				},
				"typography": {
					"textDecoration": "none"
				}
			}
		},
		"css": "& { display: inline-block; backdrop-filter: blur(8px); }"
	}
}
